{
  "name": "rad-tech01-student",
  "account_id": "27038971cc4e08b4089b6283e59f7453",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/teacher", "/teacher/*"]
  },
  "vars": {
    "FRONTEND_ORIGIN": ""
  },
  "durable_objects": { "bindings": [{ "name": "ARROWS", "class_name": "ArrowWorkspace" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CourseQuota"] },
    { "tag": "v2-arrows", "new_sqlite_classes": ["ArrowWorkspace"] }
  ],
  "observability": { "enabled": false }
}
